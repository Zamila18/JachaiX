# Docker Compose environment variables
# Copy this to .env and fill in your values

MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=jachaix
MYSQL_USER=jachaix
MYSQL_PASSWORD=your_db_password_here

# Jina embeddings API key (get one free at jina.ai). Required for the embedder
# service / knowledge base. docker-compose.yml reads it from here.
JINA_API_KEY=

# Optional: Google News API key for Auto-RAG web fallback (blank = disabled)
GNEWS_API_KEY=
