APP_NAME=JachaiX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jachaix
DB_USERNAME=jachaix
DB_PASSWORD=your_db_password_here

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Python Microservices ──────────────────────────────────────────────────────
# When running via Docker Compose, use service names:
#   OCR_SERVICE_URL=http://ocr-service:5001
#   EMBEDDER_SERVICE_URL=http://embedder-service:5002
#   RERANKER_SERVICE_URL=http://reranker-service:5003
# When Python services run on host (Windows dev), use:
OCR_SERVICE_URL=http://host.docker.internal:5001
OCR_TIMEOUT_SECONDS=60
OCR_CONNECT_TIMEOUT_SECONDS=8
OCR_RETRY_ATTEMPTS=2
OCR_RETRY_SLEEP_MS=800
EMBEDDER_SERVICE_URL=http://host.docker.internal:5002
RERANKER_SERVICE_URL=http://host.docker.internal:5003

# ── OpenAI / Ollama ───────────────────────────────────────────────────────────
# For Ollama (free, local):
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# For real OpenAI:
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Mail (optional) ───────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@jachaix.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# JachaiX Services
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

OCR_SERVICE_URL=http://ocr-service:5001
OCR_TIMEOUT_SECONDS=60
OCR_CONNECT_TIMEOUT_SECONDS=8
OCR_RETRY_ATTEMPTS=2
OCR_RETRY_SLEEP_MS=800
EMBEDDER_SERVICE_URL=http://embedder-service:5002
RERANKER_SERVICE_URL=http://reranker-service:5003
RERANKER_EN_SERVICE_URL=http://reranker-en-service:5008

# LLM (Ollama OpenAI-compatible endpoint)
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2:0.5b
OPENAI_CLAIM_MODEL=qwen2:0.5b
OPENAI_QUERY_MODEL=qwen2:0.5b
OPENAI_VERDICT_MODEL=qwen2:0.5b
OPENAI_VERDICT_FAST_MODEL=qwen2:0.5b
OPENAI_VERDICT_STRONG_MODEL=qwen2:0.5b
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Retrieval tuning
RETRIEVAL_TOP_K_PER_QUERY=6
RETRIEVAL_MAX_CANDIDATES=10
RETRIEVAL_MAX_QUERIES=4
RETRIEVAL_ENABLE_RERANK=false
RETRIEVAL_RERANK_TOP_K=3
RETRIEVAL_ENABLE_QUERY_REWRITE=false
RETRIEVAL_SEARCH_TIMEOUT=4
RETRIEVAL_RERANK_TIMEOUT=4
RETRIEVAL_ENABLE_CACHE=true
RETRIEVAL_SEARCH_CACHE_TTL_SECONDS=900
RETRIEVAL_RERANK_CACHE_TTL_SECONDS=900
RETRIEVAL_ENABLE_METADATA_PREFILTER=false
RETRIEVAL_PREFILTER_MIN_RELIABILITY=0.00
RETRIEVAL_PREFILTER_RECENT_DAYS=0
RETRIEVAL_PREFILTER_TRUSTED_SOURCES=who,who_news,reuters,ap,un_news,bbc,bbc_bangla,bdnews24,prothom_alo,kalerkantho,ittefaq,jugantor,rumorscanner
RETRIEVAL_SIMILARITY_THRESHOLD=0.30
RETRIEVAL_DECISIVE_RELEVANCE_MIN=0.50
RETRIEVAL_ENABLE_BANGLISH_PARAPHRASES=true
VERDICT_ENABLE_CANONICAL_SHORTCUTS=false

# Retrieval upgrades
RETRIEVAL_ENABLE_BM25=true
RETRIEVAL_ENABLE_COMPRESSION=true
RETRIEVAL_COMPRESSION_TIMEOUT=5
RETRIEVAL_ENABLE_MULTI_PERSPECTIVE=true

# ── Parallel LLM Verdict Providers ───────────────────────────────────────────
# Get free keys at: groq.com | aistudio.google.com | openrouter.ai | cerebras.ai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=12
GROQ_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT=14
GEMINI_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=10
OPENROUTER_ENABLED=true

# Second OpenRouter slot — strong free multilingual model (reuses OPENROUTER_API_KEY)
OPENROUTER_STRONG_MODEL=google/gemma-4-31b-it:free
OPENROUTER_STRONG_TIMEOUT=12
OPENROUTER_STRONG_ENABLED=true

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TIMEOUT=8
CEREBRAS_ENABLED=true

# ── Hugging Face Inference Providers (OpenAI-compatible) — strong multilingual/Bangla ──
# Free token at https://huggingface.co/settings/tokens (starts with hf_)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT=20
HUGGINGFACE_ENABLED=true

# Consensus settings
VERDICT_POOL_TIMEOUT=20
VERDICT_MIN_PROVIDERS=2
VERDICT_HIGH_CONFIDENCE_MIN=0.80
VERDICT_STANDARD_CONFIDENCE_MIN=0.60
VERDICT_OLLAMA_FALLBACK=true

# Verdict tuning
VERDICT_FAST_CONFIDENCE_THRESHOLD=0.55
VERDICT_FAST_MODEL_TIMEOUT=6
VERDICT_STRONG_MODEL_TIMEOUT=12
VERDICT_ENABLE_STRONG_MODEL=false
VERDICT_ENABLE_QUESTION_MODE=true
VERDICT_QUESTION_NORMALIZE_TIMEOUT=3
VERDICT_ENABLE_CLAIM_UNDERSTANDING=true
VERDICT_CLAIM_UNDERSTANDING_TIMEOUT=5
VERDICT_ENABLE_HYDE=true
VERDICT_HYDE_TIMEOUT=5

# ── Image Forensics Service ───────────────────────────────────────────────────
FORENSICS_SERVICE_URL=http://image-forensics-service:5007
FORENSICS_TIMEOUT_SECONDS=20

# ── KB Crawl / GNews ─────────────────────────────────────────────────────────
GNEWS_API_KEY=
PYTHON_BIN=python3

# ── Auto-RAG Web Fallback (Google News RSS — no API key required) ─────────────
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_MAX_RESULTS=4
WEB_FALLBACK_FETCH_FULL=true
WEB_FALLBACK_MIN_SCORE=0.65
WEB_FALLBACK_WIKIPEDIA=true

# Trust label thresholds
TRUST_LABEL_TRUSTWORTHY_MIN=0.75
TRUST_LABEL_UNCERTAIN_MIN=0.45
TRUST_LABEL_SUSPICIOUS_MIN=0.20

JWT_SECRET=
JWT_ALGO=HS256
JWT_EXPIRES_IN=60d
JWT_EXPIRES_IN_SHORT=7d

ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
ADMIN_3_EMAIL=
ADMIN_3_PASSWORD=
ADMIN_4_EMAIL=
ADMIN_4_PASSWORD=
