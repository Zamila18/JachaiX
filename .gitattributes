# Shell scripts MUST be LF so they parse under bash inside Linux containers
# even when checked out on a Windows host. CRLF breaks parsing (e.g. it
# crash-looped the kb-worker crawler with `$'\r': command not found`).
*.sh   text eol=lf
*.bash text eol=lf
*.php text eol=lf
*.py  text eol=lf
*.js  text eol=lf
*.ts  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env  text eol=lf
Dockerfile* text eol=lf
